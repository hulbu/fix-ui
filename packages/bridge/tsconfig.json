{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    // The maps carry their own sources, so the tarball ships `dist` and nothing
    // else: a stack trace resolves without `src` being published alongside it.
    "inlineSources": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
