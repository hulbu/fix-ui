{
  "name": "fixui",
  "version": "0.2.0",
  "description": "Point at any UI element in your running app and leave a note for your coding agent.",
  "keywords": [
    "fix-ui",
    "feedback",
    "element-picker",
    "devtools",
    "next",
    "vite",
    "react",
    "mcp",
    "mcp-server",
    "ai-agent",
    "coding-agent"
  ],
  "homepage": "https://github.com/hulbu/fix-ui#readme",
  "bugs": {
    "url": "https://github.com/hulbu/fix-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulbu/fix-ui.git",
    "directory": "packages/fixui"
  },
  "license": "MIT",
  "type": "module",
  "types": "./dist/embed/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/embed/index.d.ts",
      "default": "./dist/embed/index.js"
    },
    "./react": {
      "types": "./dist/embed/react.d.ts",
      "default": "./dist/embed/react.js"
    },
    "./next": {
      "types": "./dist/embed/next.d.ts",
      "default": "./dist/embed/next.js"
    },
    "./vite": {
      "types": "./dist/embed/vite.d.ts",
      "default": "./dist/embed/vite.js"
    },
    "./dist/fixui.global.js": "./dist/fixui.global.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fixui": "./dist/bridge/cli.js"
  },
  "files": [
    "dist",
    "skills/fix-ui",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm run build:browser && pnpm run build:node && pnpm run build:global",
    "build:browser": "tsc -p tsconfig.browser.json",
    "build:node": "tsc -p tsconfig.node.json",
    "build:global": "esbuild src/embed/global.ts --bundle --format=iife --platform=browser --target=chrome116,firefox115,safari16 --legal-comments=none --outfile=dist/fixui.global.js",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.browser.typecheck.json && tsc -p tsconfig.node.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.0",
    "jsdom": "^26.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "5.9.3",
    "vitest": "^3.2.0"
  }
}
