{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Typechecking must not depend on a build artifact: `pnpm -r typecheck` has
    // to be runnable on a fresh clone, and a stale `core/dist` would otherwise
    // typecheck this package against yesterday's core. Nothing is emitted here,
    // so the mapping cannot leak into any published declaration.
    "paths": {
      "@hulbu/fixui-core": ["../core/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vitest.config.ts"],
  "exclude": []
}
