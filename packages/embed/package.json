{
  "name": "@hulbu/fixui",
  "version": "0.0.1",
  "description": "Point at any UI element in your running app and leave a note for your coding agent.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./next": "./src/next.tsx",
    "./vite": "./src/vite.ts"
  },
  "scripts": {
    "build": "esbuild src/global.ts --bundle --format=iife --platform=browser --target=chrome116,firefox115,safari16 --legal-comments=none --outfile=dist/fixui.global.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hulbu/fixui-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.0",
    "jsdom": "^26.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "5.9.3",
    "vitest": "^3.2.0"
  }
}
