{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "chrome"],
    // `fixui` resolves through its `exports` to a built `.d.ts`. The suite
    // builds the package before it runs, but a typecheck should not need a
    // build artifact to exist, so it reads the embed's source directly.
    "paths": {
      "fixui": ["../packages/fixui/src/embed/index.ts"]
    }
  },
  "include": ["*.ts", "helpers/**/*.ts", "tests/**/*.ts", "fixtures/src/**/*.ts", "fixtures/src/**/*.tsx"]
}
