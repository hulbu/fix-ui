{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["chrome"]
  },
  // The picker engine is reached by a relative path into `packages/fixui/src`,
  // not through the `fixui` package: `fixui` publishes the browser *embed* at
  // `.`, and this adapter needs the engine underneath it. This package is
  // private and always bundled from source by esbuild, so a source path is the
  // honest specifier — and it keeps a typecheck on a fresh clone from depending
  // on anything being built first.
  "include": ["src/**/*.ts", "vitest.config.ts"]
}
